name: NeoLoad Controller Project (zip) with User Data

on:
  workflow_dispatch:
    inputs:
      api_url:
        required: true
        description: 'NeoLoad Web Api Url'
        default: 'https://neoload-api.saas.neotys.com/'
      zone_id:
        required: true
        description: 'Zone identifier'
        default: 'y1e48'
      scenario:
        required: true
        description: 'Scenario name in the NeoLoad Controller project (1 users)'
        default: 'scenario1'
      data_file:
        required: true
        description: 'Full path of the users CSV on the runner PC'
        default: 'C:\temp\Nodata.csv'

permissions:
  contents: read
  checks: write

env:
  API_URL: ${{ github.event.inputs.api_url }}
  ZONE_ID: ${{ github.event.inputs.zone_id }}
  SCENARIO: ${{ github.event.inputs.scenario }}
  DATA_SOURCE: ${{ github.event.inputs.data_file }}
  PROJECT_ZIP: Git_NeoLoad_RD_UserCred.zip
  DATA_TARGET: data\users.csv
  MIN_ROWS: '1'

jobs:
  neoload_nlp_zip:
    name: NeoLoad Controller project run
    runs-on: self-hosted
    steps:
      - name: Checkout the repository
        uses: actions/checkout@v4

      - name: Install NeoLoad CLI
        run: pip install -U neoload

      - name: Login to NeoLoad Web
        run: >-
          neoload login
          --url ${{ env.API_URL }}
          ${{ secrets.NEOLOAD_TOKEN }}

      - name: Prepare NeoLoad test
        run: >-
          neoload test-settings
          --zone ${{ env.ZONE_ID }}
          --scenario ${{ env.SCENARIO }}
          createorpatch "DemoWebShop NLP"

      - name: Prepare the project, add the user data and upload
        shell: powershell
        run: |
          $src = $env:DATA_SOURCE
          if (-not (Test-Path -LiteralPath $src)) { throw "Data file not found: $src" }
          if (Test-Path nlp_project) { Remove-Item -Recurse -Force nlp_project }
          New-Item -ItemType Directory -Path nlp_project | Out-Null
          robocopy . nlp_project /E /XD .git .github nlp_project /NFL /NDL /NJH /NJS | Out-Null
          $nlp = Get-ChildItem -Path nlp_project -Filter *.nlp | Select-Object -First 1
          if (-not $nlp) { throw "No .nlp file found in the repository" }
          $dir = $nlp.DirectoryName
          Write-Host "Project file: $($nlp.Name)"
          $target = Join-Path $dir $env:DATA_TARGET
          New-Item -ItemType Directory -Force -Path (Split-Path $target) | Out-Null
          $lines = @(Get-Content -LiteralPath $src | Where-Object { $_.Trim() -ne '' } | ForEach-Object { $_ -replace "`t", "," })
          Set-Content -LiteralPath $target -Value $lines -Encoding ascii
          $rows = $lines.Count - 1
          Write-Host "Data rows copied: $rows"
          if ($rows -lt [int]$env:MIN_ROWS) { throw "Need at least $env:MIN_ROWS data rows, found $rows" }
          neoload project --path "$dir" upload
          if ($LASTEXITCODE -ne 0) { throw "neoload project upload failed" }

      - name: NeoLoad run test
        run: >-
          neoload run
          --external-url ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          --external-url-label "Github Action Run ${{ github.run_number }}"
          --name "Demo Web Shop NLP - Github build ${{ github.run_number }}"
          --description "Started from Github Actions"

      - name: Generate Test Report
        id: report
        if: ${{ success() }}
        run: neoload test-results junitsla

      - name: Publish Test Report
        if: steps.report.outcome == 'success'
        uses: scacap/action-surefire-report@v1
        with:
          report_paths: junit-sla.xml
          fail_on_test_failures: true
          fail_if_no_tests: false
